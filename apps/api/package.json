{
  "name": "@mern/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec \"ts-node --esm src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'Configure lint script'",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@shared/utils": "workspace:*",
    "express": "^4.18.2",
    "@prisma/client": "^5.10.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "ts-node": "^10.9.1",
    "nodemon": "^2.0.22",
    "prisma": "^5.10.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2"
  }
}
