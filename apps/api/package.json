{
  "name": "@mern/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec \"node --loader ts-node/esm src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@shared/utils": "workspace:*",
    "express": "^4.18.2",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.22.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "morgan": "^1.10.0",
    "pm2": "^5.4.3",
    "prisma": "^5.10.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "ts-node": "^10.9.1",
    "nodemon": "^2.0.22",
    "vitest": "^3.2.4",
    "supertest": "^7.1.1",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/supertest": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9"
  }
}
