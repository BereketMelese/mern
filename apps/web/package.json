{
  "name": "@mern/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
