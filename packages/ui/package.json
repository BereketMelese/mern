{
  "name": "@repo/ui",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/styles/globals.css -o dist/styles.css --minify",
    "build": "pnpm run build:css && tsup",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist storybook-static"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "@storybook/react": "^7.6.24",
    "@storybook/react-vite": "^7.6.24",
    "@storybook/addon-essentials": "^7.6.24",
    "@storybook/addon-interactions": "^7.6.24",
    "@storybook/addon-links": "^7.6.24",
    "storybook": "^7.6.24",
    "vite": "^5.0.0"
  }
}
