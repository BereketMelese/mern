{
  "name": "mern-monorepo",
  "version": "1.0.0",
  "description": "MERN monorepo with pnpm workspaces",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:apps": "pnpm -r --parallel --filter @mern/api --filter @mern/web run dev",
    "build": "pnpm -r --filter ./packages --parallel run build && pnpm -r --filter ./apps --parallel run build",
    "prepare": "husky",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "pnpm -r run type-check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "pnpm --filter @shared/utils run test && pnpm --filter @mern/api run test && pnpm --filter @mern/web run test",
    "test:e2e": "pnpm --filter @mern/web run test:e2e",
    "test": "pnpm test:unit && pnpm test:e2e",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    }
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.0",
    "@storybook/addon-interactions": "^7.6.0",
    "@storybook/react": "^7.6.0",
    "@storybook/react-vite": "^7.6.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@playwright/test": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "storybook": "^10.3.6",
    "typescript": "^5.3.0"
  }
}
